{
  "rules": {
    ".read": false,
    ".write": false,
    "games": {
      "$code": {
        ".read": "data.exists()",
        ".write": "$code.matches(/^[A-Z]{4}$/) && ((!data.exists() && newData.child('created').val() <= now + 60000 && newData.child('created').val() >= now - 600000) || (data.exists() && !newData.exists() && data.child('created').val() < now - 86400000))",
        ".validate": "newData.hasChildren(['created', 'startedAt', 'fear', 'points', 'code'])",
        "created": { ".validate": "newData.isNumber()" },
        "startedAt": {
          ".write": "root.child('games/' + $code + '/created').exists() && data.val() === 0",
          ".validate": "newData.isNumber()"
        },
        "fear": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3" },
        "test": { ".validate": "newData.isBoolean()" },
        "code": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{6}$/)" },
        "points": {
          "$i": {
            ".validate": "$i.matches(/^[0-6]$/) && newData.hasChildren(['lat', 'lng'])",
            "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
            "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
            "$other": { ".validate": false }
          }
        },
        "players": {
          "$pid": {
            ".write": "root.child('games/' + $code + '/created').exists() && $pid.matches(/^[a-z0-9]{8,20}$/)",
            ".validate": "newData.hasChildren(['nick', 'joined', 'seen'])",
            "nick": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "joined": { ".validate": "newData.isNumber()" },
            "seen": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "arrived": {
          "$s": {
            ".write": "root.child('games/' + $code + '/created').exists()",
            ".validate": "$s.matches(/^[1-7]$/) && newData.isBoolean()"
          }
        },
        "solved": {
          "$s": {
            ".write": "root.child('games/' + $code + '/created').exists()",
            ".validate": "$s.matches(/^[1-7]$/) && newData.isBoolean()"
          }
        },
        "penalties": {
          "$id": {
            ".write": "root.child('games/' + $code + '/created').exists() && !data.exists()",
            ".validate": "newData.isNumber() && newData.val() >= -600000 && newData.val() <= 600000"
          }
        },
        "horde": {
          "$pid": {
            ".write": "root.child('games/' + $code + '/created').exists() && $pid.matches(/^[a-z0-9]{8,20}$/)",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          }
        },
        "finished": {
          ".write": "root.child('games/' + $code + '/created').exists()",
          ".validate": "newData.isNumber()"
        },
        "$other": { ".validate": false }
      }
    }
  }
}
